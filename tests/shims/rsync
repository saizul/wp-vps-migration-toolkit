#!/usr/bin/env bash
# Stub rsync: exit codes come from SHIM_RSYNC_RCS ("30 0" = fail once, then succeed).
. "$(dirname "$0")/_log"
shim_log "$@"
rc=0
if [ -n "${SHIM_RSYNC_RCS:-}" ]; then
  counter="${SHIM_STATE:-/tmp}/rsync.count"
  n=$(cat "$counter" 2>/dev/null || echo 0)
  # shellcheck disable=SC2086  # intentional word splitting of the return-code list
  set -- $SHIM_RSYNC_RCS
  n=$((n + 1))
  echo "$n" >"$counter"
  if [ "$n" -le "$#" ]; then
    rc=${!n}
  else
    rc=0
  fi
fi
exit "$rc"
