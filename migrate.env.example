# Copy to migrate.env and edit. migrate.env is git-ignored.
# Lines are plain shell assignments. Never commit real hosts or secrets.
# Authentication is SSH key / agent only (BatchMode); no passwords are stored.

# --- Source (old shared host / cPanel) --------------------------------------
SRC_SSH_HOST=old-host.example.com
SRC_SSH_USER=cpaneluser
SRC_SSH_PORT=22
#SRC_SSH_KEY=$HOME/.ssh/id_ed25519
#SRC_SSH_STRICT=accept-new
SRC_WP_PATH=/home/cpaneluser/public_html
SRC_URL=https://www.example.com
# WP-CLI binary on the source and extra args (cPanel often needs a PHP path).
#SRC_WP_CLI=wp
#SRC_WP_CLI_ARGS=

# --- Target (this VPS: CloudPanel or plain Nginx) ---------------------------
# Scripts run ON the VPS and pull from the source.
DST_WP_PATH=/home/example/htdocs/www.example.com
DST_URL=https://www.example.com
DST_IP=203.0.113.10
# Owner applied after rsync (CloudPanel: the site user). Optional.
#DST_OWNER=example:example
#WP_CLI=wp
# Use --allow-root only if you really run as root.
#WP_CLI_ARGS=
#PHP_BIN=php
#MIN_TARGET_PHP=7.4

# --- Behaviour ---------------------------------------------------------------
#WORK_DIR=./work
#RSYNC_RETRIES=5
#RSYNC_RETRY_SLEEP=5
#RSYNC_EXTRA_EXCLUDES="wp-content/uploads/large-videos"
# verify.sh: accept self-signed/missing certs before DNS cutover (1) or not (0)
#VERIFY_INSECURE=1
# verify.sh: extra "path=expected,codes" pairs, space separated
#VERIFY_EXTRA_URLS="/about/=200 /old-page/=301"
